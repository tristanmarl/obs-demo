DT_TENANT_URL=https://example.invalid
DT_API_TOKEN=replace-with-an-environment-token
DT_DATA_INGEST_TOKEN=
K8S_CLUSTER_NAME=nebulatrace-demo
DYNAKUBE_NAME=nebulatrace
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=demo,service.namespace=nebulatrace,team=service-monitoring
DT_CUSTOM_PROP=dt.owner=service-monitoring
LOADGEN_DELAY_MS=750
LOADGEN_BURST=1
FAAS_VERSION=1.0.0
DEMO_CONTROLS_ENABLED=true
LOADGEN_ERROR_RATE=0.02
MEMORY_PRESSURE_MB=4
MEMORY_SURVIVOR_BATCHES=8
IMAGE_REGISTRY=ghcr.io/tristanmarl/nebulatrace
IMAGE_TAG=latest
