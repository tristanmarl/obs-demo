[Unit]
Description=TraceForge Dynatrace OpenTelemetry Collector
After=network-online.target
Wants=network-online.target

[Service]
# Runs as root: journald access and process.disk.io need it.
ExecStart=/usr/local/bin/dynatrace-otel-collector --config=/etc/traceforge/otel-collector.yaml
EnvironmentFile=/etc/traceforge/otel-collector.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
