[Unit]
Description=TraceForge edge agent
After=traceforge-otel-collector.service network-online.target
Wants=traceforge-otel-collector.service network-online.target

[Service]
ExecStart=/usr/local/bin/tf-edge-agent
EnvironmentFile=-/etc/traceforge/edge-agent.env
DynamicUser=yes
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
